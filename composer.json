{
    "name": "darvis/api-x",
    "description": "Post text and images to X (Twitter) from Laravel: a small API client, an artisan command and a local MCP server for AI agents.",
    "keywords": [
        "laravel",
        "x",
        "twitter",
        "x-api",
        "mcp",
        "social",
        "laravel-boost"
    ],
    "type": "library",
    "license": "MIT",
    "homepage": "https://arviddejong.github.io/api-x/",
    "authors": [
        {
            "name": "Arvid de Jong",
            "email": "info@arvid.nl"
        }
    ],
    "support": {
        "issues": "https://github.com/ArvidDeJong/api-x/issues",
        "source": "https://github.com/ArvidDeJong/api-x"
    },
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/mcp": "^1.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "phpunit/phpunit": "^11.0|^12.0|^13.0"
    },
    "suggest": {
        "laravel/mcp": "Required for the local MCP server that lets AI agents post (^1.0)."
    },
    "autoload": {
        "psr-4": {
            "Darvis\\ApiX\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Darvis\\ApiX\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Darvis\\ApiX\\XServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint --test",
        "format": "pint",
        "analyse": "phpstan analyse --memory-limit=1G"
    }
}
